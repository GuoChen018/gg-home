---
import MainHead from './MainHead.astro';
import MainFooter from './MainFooter.astro';
import Nav from './Nav.astro';

interface Props {
    title: string; 
    description: string;
    thumbnail: string;
    ogType?: string;
    ogImageWidth?: number;
    ogImageHeight?: number;
}

const {
    title = "Guo's Portfolio",
    description = "The digital home I always wanted",
    thumbnail = "/images/og-img.jpg",
    ogType = 'website',
    ogImageWidth,
    ogImageHeight,
} = Astro.props as Props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://www.guochen.design');

import '../styles/global.css';

---

<html lang="en">
	<MainHead {title} {description} {thumbnail} canonicalURL={canonicalURL} {ogType} {ogImageWidth} {ogImageHeight} />
    
	<body>
        <a href="#main" class="skip">Skip to main content</a>
        <Nav/>
        <slot>

        </slot>
        <MainFooter/>
    
        <script>
            // Enable hidden nav bar. Re-query nav: view transitions replace it, so a
            // reference captured on the first page would update a detached node.
            {
                let lastScrollY = window.scrollY;
                const navEl = () => document.querySelector("nav");

                window.addEventListener("scroll", () => {
                    const nav = navEl();
                    if (!nav) return;
                    if (lastScrollY < window.scrollY && window.scrollY > 8) {
                        nav.classList.add("nav--hidden");
                    } else {
                        nav.classList.remove("nav--hidden");
                    }

                    lastScrollY = window.scrollY;
                }, { passive: true });

                document.addEventListener("astro:page-load", () => {
                    navEl()?.classList.remove("nav--hidden");
                    lastScrollY = window.scrollY;
                });
            }

            // Mark client navigations before the new body is inserted so the
            // entrance fade does not restart (mobile paints, then flashes).
            document.addEventListener("astro:before-swap", (event) => {
                const swapEvent = event as Event & { newDocument: Document };
                swapEvent.newDocument.documentElement.classList.add("astro-navigated");
            });

            // Only download/decode videos near the viewport; pause them once offscreen
            document.addEventListener('astro:page-load', () => {
                const videos = document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]');
                if (!videos.length) return;

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(({ target, isIntersecting }) => {
                        const video = target as HTMLVideoElement;
                        if (isIntersecting) {
                            video.play().catch(() => {});
                        } else {
                            video.pause();
                        }
                    });
                }, { rootMargin: '300px 0px' });

                videos.forEach((video) => observer.observe(video));
                document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
            });
        </script>
	</body>
</html>

