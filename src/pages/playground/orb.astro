---
import MainLayout from '../../layouts/MainLayout.astro';

const name = "Orb";
const date = "2026";
---

<MainLayout title={`${name} - Playground`} description={`${name} Prototype`} thumbnail="/images/og-img.jpg">
    <main class="playground-item-page">
        <a href="/playground" class="playground-back"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 8H3M3 8L7 4M3 8L7 12"/></svg>Back</a>
        <h4>{name}</h4>
        <h5>{date}</h5>

        <div class="playground-prototype orb-detail">
            <video class="orb-detail-video" muted autoplay loop playsinline preload="auto" src="/video/orb.mp4" width="440" height="440"></video>
        </div>
    </main>
</MainLayout>

<style>
    .playground-item-page {
        max-width: 80ch;
        margin: 0 auto;
        padding-left: 6rem;
        padding-right: 6rem;
        padding-bottom: 4rem;
        min-height: calc(100vh - 200px);
    }

    .playground-item-page h5 {
        margin-bottom: 2rem;
    }

    .playground-prototype {
        width: 100%;
        margin-bottom: 3rem;
        display: flex;
        justify-content: center;
    }

    .orb-detail {
        background: none;
    }

    .orb-detail-video {
        width: 240px;
        height: 240px;
        object-fit: cover;
        border-radius: 50%;
        display: block;
    }

    @media screen and (max-width: 1200px) {
        .playground-item-page {
            padding-left: 1rem;
            padding-right: 1rem;
        }
    }
</style>
