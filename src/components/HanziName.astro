<style is:global>
    .hanzi-name-wrap {
        position: relative;
        display: inline-block;
        cursor: default;
    }

    .hanzi-name {
        position: absolute;
        left: 50%;
        bottom: calc(100% - 0.5em);
        z-index: -1;
        height: 1.75em;
        width: 3.5em;
        transform: translate(-50%, 0.25em);
        -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 95%);
        mask-image: linear-gradient(to bottom, #000 35%, transparent 95%);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.25s ease-out, transform 0.25s ease-out;
    }

    .hz-stroke {
        fill: none;
        stroke: var(--color-text-primary);
        stroke-opacity: 0.18;
        stroke-width: 200;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: var(--len) calc(var(--len) + 400);
        stroke-dashoffset: var(--len);
        /* reset only after the fade-out finishes */
        transition: stroke-dashoffset 0s linear 0.25s;
    }

    .hanzi-name-wrap:hover .hanzi-name {
        opacity: 1;
        transform: translate(-50%, 0);
        transition: opacity 0.2s ease-out, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .hanzi-name-wrap:hover .hz-stroke {
        stroke-dashoffset: 0;
        transition: stroke-dashoffset var(--dur) cubic-bezier(0.45, 0, 0.55, 1) var(--delay);
    }

    @media (prefers-reduced-motion: reduce) {
        .hanzi-name-wrap:hover .hz-stroke {
            transition: none;
        }
    }
</style>
